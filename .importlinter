[importlinter]
root_package = basicly

# The engine's real tier stack, highest first. Higher tiers may import lower ones;
# an import in the other direction breaks the contract and names both modules.
#
# `exhaustive` is the part that keeps this gate honest: every top-level module of
# `basicly` must appear in exactly one tier, so a new module cannot join the package
# without a maintainer deciding where it sits. The contract this replaced forbade
# `basicly.fragments` and `basicly.targets` — neither module existed, and neither
# structurally could (fragments and targets are YAML under `.basicly/core/`), so it
# reported `1 kept, 0 broken` over the whole tree forever.
#
# Siblings on one line are separated by `|`, which means independent: they may not
# import each other either. That is what makes a tier a tier rather than a bucket.
[importlinter:contract:engine-layering]
name = Engine modules only import downward through the declared tiers
type = layers
containers =
    basicly
exhaustive = True
layers =
    cli
    board_cli
    board_facts
    board_serve
    board_actions
    supervise | usage_report
    loop | release
    board_snapshot
    board_usage
    catalog_lint | contention | cost_rollup | curate | health | landing_gate | tracker_query | tracker_write
    commit | merge
    rebase | repair_brief | wip | working_set
    classify | context_meter | decompose | loop_state | plan_entry | retrospective | rubrics
    validate_gate
    dispatch_brief
    catalog_token_cost | skill_coverage
    decisions
    handoff
    plan_gate | policy | routing_evals | tuning | verify
    capability_proof
    config | worktree
    lane_split
    lane_log
    claude_settings | runner
    context_window
    agents | catalog_verify | copilot_store | fleet | hooks | loader | models | permissions | planner | renderers | skills | state
    skill_pairing
    provider_limit | runner_usage
    decider_contract
    corpus_drift | decision_marker
    artifact_record | lens_review | run_record | skill_source
    spend_calibration
    demonstration_proof
    dependency_graph | gate_source | label_source
    tracker
    owned_write
    comment_rows | mirror | re_record
    write_verbs
    owned_store
    tracker_argv
    dispatch_phase
    runner_envelope
    board_sections
    board_render
    board_footer | board_regions
    board_wall
    board_fields | board_schema
    base_lock | catalog | catalog_routing | catalog_source | checkout | copilot_tools | dropin | integrity | needs_input | plan_record | precommit_config | projection | read_cost | redact | review | roles | scaffolds | schema | session | tracker_usage | tree_schema | ui | usage | verify_artifact
    tracker_paths
    stemmer
# One cycle survives as a function-level import carrying `# noqa: PLC0415`; the
# top-level direction is the one the tiers encode. Listing it here is not a
# weakening: `unmatched_ignore_imports_alerting` defaults to `error`, so when the cycle
# is finally removed this contract fails until the exemption goes with it.
ignore_imports =
    basicly.policy -> basicly.decisions

# The projector's per-target renderers: each target module renders on top of the
# shared helpers and knows nothing of its siblings. Exhaustive here too, so adding a
# fourth target forces a placement rather than silently escaping the contract.
[importlinter:contract:renderer-layering]
name = Target renderers sit above the shared renderer helpers and are independent
type = layers
containers =
    basicly.renderers
exhaustive = True
layers =
    claude | codex | copilot
    common

# The C12 rule the tier stack cannot carry: every board consumer reads the snapshot document
# and nothing else. `owned_store`, `owned_write`, `mirror` and `tracker_argv` sit near the
# bottom of the stack, so layering alone lets anything above them import them — which is
# exactly what a renderer that only ever works against basicly's own producer would do. The
# reference producer `board_snapshot` is deliberately not a source, because reading all of it is
# its whole job. `board_serve` is not one either, and the design's prediction that it would be
# was wrong: a forbidden contract counts indirect imports, and Mode B hosts the fold — measured
# 2026-08-21, adding it reported seven broken chains, every one running through `board_snapshot`
# or through the lock read `supervise` owns. Unit E's `board_actions` folds nothing, so it joins -
# and the contract is load-bearing there rather than decorative: `policy`, which mints the confirm
# code the action surface must never read, imports `tracker`, so `board_actions -> policy` breaks
# this contract through an indirect chain (basicly-rn0o.6).
[importlinter:contract:consumer-reads-only-the-snapshot]
name = A board consumer reads the snapshot document, never engine state
type = forbidden
source_modules =
    basicly.board_actions
    basicly.board_footer
    basicly.board_regions
    basicly.board_render
    basicly.board_wall
forbidden_modules =
    basicly.mirror
    basicly.owned_store
    basicly.owned_write
    basicly.tracker
    basicly.tracker_argv
    basicly.tracker_write
    basicly.write_verbs
