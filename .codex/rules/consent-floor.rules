prefix_rule(pattern = ["rm", ["-rf", "-fr"]], decision = "forbidden", justification = "Recursive force removal is denied by this repository. Use the managed worktree cleanup command.", match = ["rm -rf scratch", "rm -fr scratch"])
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden")
prefix_rule(pattern = ["rm", "-f", "-r"], decision = "forbidden")
prefix_rule(pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]], decision = "forbidden", justification = "History-rewriting pushes are denied by this repository.")
prefix_rule(pattern = ["git", ["commit", "push"], ["--no-verify", "--no-gpg-sign"]], decision = "forbidden", justification = "Run the repository hooks and signing checks; bypassing gates is prohibited.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean", ["-f", "-fd", "-df", "-fx", "-xf", "-fdx", "-xdf", "-ffd"]], decision = "forbidden")
prefix_rule(pattern = ["git", ["filter-branch", "filter-repo"]], decision = "forbidden")
prefix_rule(pattern = ["git", ["reset", "clean", "checkout", "restore", "stash", "push"]], decision = "prompt", justification = "Obtain explicit user consent for destructive Git actions or publication. Check the repository instructions before requesting approval.")
prefix_rule(pattern = ["git", ["-C", "-c", "--git-dir", "--work-tree"]], decision = "prompt", justification = "Git global options can change the target repository or bypass command-prefix checks. Review the full command against repository rules.")
prefix_rule(pattern = ["git", "worktree", ["remove", "prune"]], decision = "prompt", justification = "Use basicly worktree cleanup for managed lanes; review direct removal of worktrees.")
