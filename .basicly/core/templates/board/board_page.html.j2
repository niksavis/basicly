<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>basicly board — {{ schema }}</title>
    <style>
      /* Every custom property below is already defined in site/index.html :root. The board
         looks like basicly because it lifts that palette rather than inventing one. */
      :root {
        --bg: #0f1117;
        --bg-raise: #171a23;
        --bg-sunk: #0b0d12;
        --border: #262b38;
        --border-lit: #333a4d;
        --text: #d7dce6;
        --text-bright: #f2f5fa;
        --text-dim: #8b93a7;
        --indigo: #818cf8;
        --indigo-deep: #6366f1;
        --amber: #f59e0b;
        --orange: #fb923c;
        --green: #34d399;
        --mono:
          ui-monospace, "Cascadia Code", "JetBrains Mono", Consolas, monospace;
        --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      * {
        box-sizing: border-box;
        margin: 0;
      }
      /* No animation to reduce, and the block is here anyway: a later region that gains one
         inherits the honoured setting rather than shipping without it. */
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
          animation: none !important;
        }
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        /* Six metres, not a laptop: the floor is well above site/index.html's 16px. */
        font-size: 19px;
        height: 100vh;
        line-height: 1.3;
        /* The page never scrolls and neither does a region. Anything that does not fit was
           dropped by the model, which said how many and of what. */
        overflow: hidden;
        padding: 10px;
      }
      /* Fixed columns, and rows that reflow only when a *capacity* changes. A wall display
         that moves when a number changes is unreadable, so every region caps what it draws at
         a slot count the model states and reports the rest. */
      .wall {
        display: grid;
        gap: 8px;
        grid-template-columns: minmax(0, 1fr) 470px;
        grid-template-areas:
          "head   head"
          "band   band"
          "loop   loop"
          "flight ready"
          "foot   foot"
          "tick   tick"
          "inv    inv";
        /* Each row is the height of what it holds, and never a pixel measured against the
           tallest content of the day. A hand-tuned row is one line short the moment a
           producer emits one more of anything - the footer's gate strip went from 12 checks
           to 36 and pushed `health` off the page - so the row is bounded by its content and
           the content is bounded by the model's own slot counts. `flight` takes the slack. */
        grid-template-rows: auto auto auto minmax(0, 1fr) auto auto auto;
        height: 100%;
      }
      .region {
        background: var(--bg-raise);
        border: 2px solid var(--border);
        border-radius: 6px;
        min-width: 0;
        overflow: hidden;
        padding: 6px 10px;
      }
      h2 {
        color: var(--text-dim);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      /* One declaration for both, because a reserved strip row is one line of a label: the
         `em` the row is stated in has to resolve against the type size of what the row
         actually holds, not against the body's. 1.4 of it rather than the declared
         line-height of 1.2, because a monospace glyph beside a sans label raises the line box
         above its line-height and the reservation has to clear the taller of the two - which
         is measured off the rendered page, not computed from the fonts. */
      .label,
      .strip.fixed {
        font-size: 14px;
      }
      .label {
        color: var(--text-dim);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .value,
      .mono {
        font-family: var(--mono);
      }
      .glyph {
        font-family: var(--mono);
        margin-right: 6px;
      }
      .clip {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* --- head: the tree, the run, and the money, plus the one freshness sentence ----- */
      .head {
        align-items: center;
        display: flex;
        gap: 22px;
        grid-area: head;
      }
      .head .mark {
        color: var(--indigo);
        font-size: 26px;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .head .cell {
        min-width: 0;
      }
      .head .cell .value {
        font-size: 17px;
      }
      /* The freshness sentence, once for the whole page rather than once per panel. Every
         value on the wall is drawn under it, which is what makes one enough. */
      .fresh {
        font-family: var(--mono);
        font-size: 17px;
        margin-left: auto;
        text-align: right;
        white-space: nowrap;
      }

      /* --- band: the only orange on the page ------------------------------------------- */
      /* `site/index.html` ships no red, so orange is this page's alarm channel and the band
         is its only site. A **fill** rather than a text colour, because a failing gate is
         amber text and the two hues are close: an amber outline is a red tree, an orange
         field is a person in the room waiting on an answer. */
      .band.state-waiting,
      .band.state-waiting .headline,
      .band.state-waiting .lines,
      .band.state-waiting .stale,
      .band.state-waiting .note {
        background: var(--orange);
        border-color: var(--orange);
        color: var(--bg-sunk);
      }
      .band {
        align-items: center;
        border-width: 4px;
        display: flex;
        gap: 26px;
        grid-area: band;
      }
      .band .headline {
        font-size: 40px;
        font-weight: 700;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }
      .band .lines {
        font-family: var(--mono);
        font-size: 19px;
        min-width: 0;
      }
      .band .stale {
        color: var(--amber);
        font-family: var(--mono);
        font-size: 18px;
        margin-left: auto;
        max-width: 300px;
        text-align: right;
      }

      /* --- loop: seven phases in order, counted, with the current one marked ----------- */
      .loop {
        grid-area: loop;
      }
      .phases {
        display: flex;
        gap: 6px;
        margin-top: 4px;
      }
      .phase {
        background: var(--bg-sunk);
        border: 2px solid var(--border);
        border-radius: 4px;
        flex: 1 1 0;
        min-width: 0;
        padding: 2px 6px;
        text-align: center;
      }
      .phase .count {
        display: block;
        font-family: var(--mono);
        font-size: 27px;
        font-weight: 700;
      }
      .phase .none {
        color: var(--text-dim);
        display: block;
        font-family: var(--mono);
        font-size: 17px;
      }
      /* Where the work is now, on three channels: the glyph, the indigo border, and the
         fill. Position in the ordered row is the fourth. */
      .phase.here {
        background: var(--indigo-deep);
        border-color: var(--indigo);
        border-style: solid;
      }
      .phase.here .name,
      .phase.here .count {
        color: var(--text-bright);
      }
      .note {
        color: var(--text-dim);
        font-family: var(--mono);
        font-size: 15px;
      }

      /* --- flight: fixed cards that truncate, never a grid that moves ------------------ */
      .flight {
        display: grid;
        gap: 6px;
        grid-area: flight;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: auto repeat(2, minmax(0, 1fr));
      }
      .flight > h2,
      .flight > .note {
        grid-column: 1 / -1;
      }
      .card {
        background: var(--bg-sunk);
        border: 3px solid var(--border);
        border-radius: 4px;
        min-width: 0;
        overflow: hidden;
        padding: 5px 8px;
      }
      .card.empty {
        border-style: dashed;
        opacity: 0.45;
      }
      /* The id and the phase share one line. A card is the region that takes the wall's
         slack - every other row is bounded by a capacity and this one absorbs what is left -
         so a second heading line saying as much as the first is one it cannot afford. */
      .card .title {
        align-items: baseline;
        display: flex;
        gap: 12px;
        min-width: 0;
      }
      .card .id {
        color: var(--text-bright);
        font-family: var(--mono);
        font-size: 19px;
        min-width: 0;
      }
      .card .phase-name {
        color: var(--indigo);
        flex: none;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      /* Two pairs to a line, so a card's six figures cost three rows rather than six. A card
         is the one region the wall lets shrink - it takes the slack every other row leaves -
         so its own content has to be the cheapest arrangement that still reads. */
      .card dl {
        column-gap: 8px;
        display: grid;
        grid-template-columns: repeat(2, auto minmax(0, 1fr));
        line-height: 1.15;
      }
      .card dt {
        color: var(--text-dim);
        font-size: 14px;
      }
      .card dd {
        font-family: var(--mono);
        font-size: 14px;
        margin: 0;
        min-width: 0;
      }

      /* --- ready: the ranked set, priority then id then title -------------------------- */
      .ready {
        grid-area: ready;
      }
      .ready table {
        border-collapse: collapse;
        table-layout: fixed;
        width: 100%;
      }
      .ready td {
        font-family: var(--mono);
        font-size: 17px;
        padding: 2px 0;
      }
      .ready .pri {
        color: var(--amber);
        width: 46px;
      }
      .ready .id {
        color: var(--indigo);
        width: 158px;
      }

      /* --- foot: backlog and the histogram, then gates, spend and health as one strip -- */
      .foot {
        display: grid;
        grid-area: foot;
        grid-template-columns: 430px minmax(0, 1fr);
        gap: 8px;
      }
      .strip {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 16px;
        line-height: 1.2;
        min-width: 0;
      }
      /* A strip that declares a capacity draws it as a grid and reserves every row of it,
         filled or not, so the strips below cannot move when the count above them changes. The
         grid itself is the model's: its columns and rows come from the panel, so the CSS
         cannot state a capacity the code does not.

         A reserved row is one line, so a cell here puts its label and its value on that line
         rather than above it - a two-line cell among one-line ones would take a row the grid
         had allotted to another item. */
      .strip.fixed {
        display: grid;
      }
      .strip.fixed .cell {
        align-items: baseline;
        display: flex;
        gap: 8px;
      }
      .strip.fixed .cell .value {
        font-size: inherit;
      }
      .strip .cell {
        min-width: 0;
      }
      .strip .cell .value {
        font-size: 17px;
      }
      .hist {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 12px;
        margin-top: 2px;
      }
      .events {
        color: var(--text-dim);
        font-family: var(--mono);
        font-size: 15px;
        line-height: 1.45;
      }

      /* --- tick: the only region that reads as prose ----------------------------------- */
      .tick {
        align-items: baseline;
        display: flex;
        gap: 14px;
        grid-area: tick;
      }
      .tick .lines {
        min-width: 0;
      }

      /* --- inv: the verdict's whole section roster, so nothing is silently dropped ----- */
      .inv {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 2px 12px;
        grid-area: inv;
        overflow: hidden;
      }
      .inv .chip {
        font-family: var(--mono);
        font-size: 15px;
        white-space: nowrap;
      }

      /* A bar is drawn only where the model gave one, which is only where both of its terms
         were measured. There is no markup here for a bar without a number. */
      .track {
        background: var(--bg);
        border: 1px solid var(--border-lit);
        display: inline-block;
        height: 10px;
        vertical-align: middle;
        width: 92px;
      }
      .fill {
        background: var(--indigo);
        display: block;
        height: 100%;
      }
      .fill.over {
        background: var(--amber);
      }
      /* Three channels per state: a glyph in the markup, a border style here, and colour.
         Generated from board_wall.STATES so the CSS cannot name a state the code does not. */
{%- for state in states %}
      .state-{{ state.key }} {
        border-style: {{ state.border_style }};
        border-color: {{ state.colour }};
        color: {{ state.colour }};
      }
{%- endfor %}
      /* Below 1280px the wall stops being a wall: one column, and the page may scroll,
         because a laptop reader is close enough to scroll and far too close to read a
         1920-wide grid squeezed into 1200. */
      @media (max-width: 1279px) {
        body {
          height: auto;
          overflow: auto;
        }
        .wall {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas: "head" "band" "loop" "flight" "ready" "foot" "tick" "inv";
          grid-template-rows: none;
        }
        .head,
        .band,
        .foot,
        .flight {
          flex-wrap: wrap;
          grid-template-columns: minmax(0, 1fr);
        }
        .flight {
          grid-template-rows: none;
        }
        .fresh,
        .band .stale {
          margin-left: 0;
          text-align: left;
        }
        .phases {
          flex-wrap: wrap;
        }
        .phase {
          flex: 1 1 120px;
        }
      }
    </style>
  </head>
  <body>
    <main class="wall">
      <section class="region head">
        <span class="mark">basicly</span>
{%- for cell in head %}
        <div class="cell clip">
          <div class="label">{{ cell.label }}</div>
          <div class="value clip">
{%- if cell.state %}<span class="glyph state-{{ cell.state.key }}">{{ cell.state.glyph }}</span>{% endif %}{{ cell.value }}
{%- if cell.bar %}
            <span class="track"
              ><span
                class="fill{% if cell.bar.over %} over{% endif %}"
                style="width: {{ cell.bar.width }}%"
              ></span
            ></span>
            {{ cell.bar.label }}
{%- endif %}
          </div>
        </div>
{%- endfor %}
        <p class="fresh state-{{ age.state.key }}">
          <span class="glyph">{{ age.state.glyph }}</span>as of {{ age.phrase }}<br />
          <span class="note">{{ age.generated_at }} · stale after {{ age.stale_after }}</span>
        </p>
      </section>

      <section class="region band state-{{ band.state.key }}">
        <div class="headline state-{{ band.state.key }}">
          <span class="glyph">{{ band.state.glyph }}</span>{{ band.headline }}
        </div>
        <div class="lines">
{%- for line in band.lines %}
          <div class="clip">{{ line }}</div>
{%- endfor %}
        </div>
{%- if band.stale %}
        <div class="stale">{{ band.stale }}</div>
{%- endif %}
      </section>

      <section class="region loop">
        <h2>the loop</h2>
        <div class="phases">
{%- for phase in phases %}
          <div class="phase{% if phase.here %} here{% endif %}">
{%- if phase.count is none %}
            <span class="none">{{ none_glyph }}</span>
{%- else %}
            <span class="count">{{ phase.count }}</span>
{%- endif %}
            <span class="label name clip"
              >{% if phase.here %}{{ here_glyph }} {% endif %}{{ phase.name }}</span
            >
          </div>
{%- endfor %}
        </div>
{%- if loop_note %}
        <p class="note clip">{{ loop_note }}</p>
{%- endif %}
      </section>

      <section class="region flight">
        <h2>in flight{% if flight_more %} — {{ flight_more }}{% endif %}</h2>
{%- if flight_note %}
        <p class="note clip">{{ flight_note }}</p>
{%- endif %}
{%- for card in cards %}
        <div class="card{% if not card.title %} empty{% endif %} state-{{ card.state.key }}">
{%- if card.title %}
          <div class="title">
            <div class="id clip">
              <span class="glyph state-{{ card.state.key }}">{{ card.state.glyph }}</span
              >{{ card.title }}
            </div>
            <div class="phase-name clip">{{ card.phase }}</div>
          </div>
          <dl>
{%- for cell in card.cells %}
            <dt>{{ cell.label }}</dt>
            <dd class="clip">
              {{- cell.value }}
{%- if cell.bar %}
              <span class="track"
                ><span
                  class="fill{% if cell.bar.over %} over{% endif %}"
                  style="width: {{ cell.bar.width }}%"
                ></span
              ></span>
              {{ cell.bar.label }}
{%- endif %}
            </dd>
{%- endfor %}
          </dl>
{%- if card.note %}
          <div class="note clip">{{ card.note }}</div>
{%- endif %}
{%- endif %}
        </div>
{%- endfor %}
      </section>

      <section class="region ready">
        <h2>next up{% if ready.more %} — {{ ready.more }}{% endif %}</h2>
        <table>
{%- for item in ready.rows %}
          <tr>
            <td class="pri">{{ item.priority }}</td>
            <td class="id clip">{{ item.ident }}</td>
            <td class="clip">{{ item.title }}</td>
          </tr>
{%- endfor %}
        </table>
{%- if ready.note %}
        <p class="note state-{{ ready.state.key }}">
          <span class="glyph">{{ ready.state.glyph }}</span>{{ ready.note }}
        </p>
{%- endif %}
      </section>

      <section class="region foot">
        <div>
          <h2>backlog{% if priorities_more %} — {{ priorities_more }}{% endif %}</h2>
{%- if backlog.note %}
          <p class="note state-{{ backlog.state.key }}">
            <span class="glyph">{{ backlog.state.glyph }}</span>{{ backlog.note }}
          </p>
{%- endif %}
          <div class="strip">
{%- for cell in backlog.cells %}
            <div class="cell">
              <div class="label">{{ cell.label }}</div>
              <div class="value clip">
                {{- cell.value }}
{%- if cell.bar %}
                <span class="track"
                  ><span
                    class="fill{% if cell.bar.over %} over{% endif %}"
                    style="width: {{ cell.bar.width }}%"
                  ></span
                ></span>
                {{ cell.bar.label }}
{%- endif %}
              </div>
            </div>
{%- endfor %}
          </div>
          <div class="hist">
{%- for cell in priorities %}
            <div class="cell">
              <div class="label">{{ cell.label }}</div>
              <div class="value">
                {{- cell.value }}
{%- if cell.bar %}
                <span class="track" style="width: 54px"
                  ><span class="fill" style="width: {{ cell.bar.width }}%"></span
                ></span>
{%- endif %}
              </div>
            </div>
{%- endfor %}
          </div>
        </div>
        <div>
{%- for panel in strips %}
          <h2 class="state-{{ panel.state.key }}">
            <span class="glyph">{{ panel.state.glyph }}</span>{{ panel.title }}
{%- if panel.more %} — {{ panel.more }}{% endif %}
          </h2>
{%- if panel.note %}
          <p class="note clip">{{ panel.note }}</p>
{%- endif %}
{%- if panel.caption %}
          <p class="note clip">{{ panel.caption }}</p>
{%- endif %}
          <div
            class="strip{% if panel.columns %} fixed{% endif %}"
{%- if panel.columns %}
            style="
              grid-template-columns: repeat({{ panel.columns }}, minmax(0, 1fr));
              grid-template-rows: repeat({{ panel.rows }}, 1.4em);
            "
{%- endif %}
          >
{%- for cell in panel.cells %}
            <div class="cell">
              <div class="label">
{%- if cell.state %}<span class="glyph state-{{ cell.state.key }}">{{ cell.state.glyph }}</span>{% endif %}{{ cell.label }}
              </div>
{%- if cell.value %}
              <div class="value clip">{{ cell.value }}</div>
{%- endif %}
            </div>
{%- endfor %}
          </div>
{%- endfor %}
        </div>
      </section>

      <section class="region tick">
        <span class="label">events{% if events_more %} — {{ events_more }}{% endif %}</span>
        <div class="lines events">
{%- for line in events %}
          <div class="clip">{{ line }}</div>
{%- endfor %}
        </div>
      </section>

      <section class="region inv">
        <span class="label">sections</span>
{%- for cell in inventory %}
        <span class="chip state-{{ cell.state.key }}">{{ cell.state.glyph }} {{ cell.label }}</span>
{%- endfor %}
        <span class="label">key</span>
{%- for cell in legend %}
        <span class="chip state-{{ cell.state.key }}"
          >{{ cell.state.glyph }} <span class="note">{{ cell.value }}</span></span
        >
{%- endfor %}
      </section>
    </main>
  </body>
</html>
